#!/usr/bin/env python3
"""
V1 Thermal Physics Engine for ThermoShelter SIH26051
Reduced-order transient hourly thermal model for shelter design comparison.

This implementation follows the physics specification in physics_spec_prompt.txt
and adheres to the constraints in physics_approval.txt.

IMPORTANT: This is a reduced-order transient hourly thermal model intended
for prototype design comparison, not a certified building-energy or
thermal-comfort simulation.
"""

import csv
import json
import math
import os
from pathlib import Path
from typing import Dict, List, Optional, Tuple, Any


class ThermalEngine:
    """
    V1 Reduced-order transient hourly thermal model.

    Calculates approximate hourly indoor air temperature based on:
    - Outdoor weather conditions
    - Shelter geometry and material configuration
    - Openings, orientation, ventilation, occupancy
    """

    def __init__(self,
                 materials_csv_path: str = "data/materials/material_properties.csv",
                 weather_data_path: str = "data/raw"):
        """
        Initialize the thermal engine.

        Args:
            materials_csv_path: Path to material properties CSV
            weather_data_path: Path to directory containing weather CSV files
        """
        self.materials_csv_path = materials_csv_path
        self.weather_data_path = Path(weather_data_path)
        self.materials = self._load_materials()

        # Physical constants
        self.RHO_AIR = 1.225  # kg/mÂ³ at sea level, 15Â°C
        self.CP_AIR = 1005.0  # J/(kgÂ·K) for dry air
        self.STEFAN_BOLTZMANN = 5.670374419e-8  # W/(mÂ²Â·Kâ´)

        # V1 Assumptions (documented in README.md)
        self.VENTILATION_ACH_MAP = {
            "sealed": 0.1,    # ACH - minimal infiltration
            "low": 0.5,       # ACH - low ventilation
            "medium": 1.0,    # ACH - medium ventilation
            "high": 2.0       # ACH - high ventilation
        }

        self.SENSIBLE_HEAT_PER_PERSON = 75.0  # W/person (V1 assumption)
        self.SKY_TEMPERATURE_FACTOR = 0.9     # Factor for effective sky temperature
        self.LONGWAVE_EMISSIVITY = 0.9        # Effective emissivity for LW radiation

        # Surface film thermal resistances (mÂ²Â·K/W) based on ISO 6946 / ASHRAE Fundamentals
        # R_si: interior surface film resistance, R_se: exterior surface film resistance
        # These represent convective and radiative boundary layers on envelope surfaces,
        # preventing unphysical zero-resistance when materials have high conductivity or low thickness.
        self.R_SI_WALL = 0.13    # mÂ²Â·K/W (interior vertical surface, still air)
        self.R_SE_WALL = 0.04    # mÂ²Â·K/W (exterior vertical surface, wind-exposed)
        self.R_SI_ROOF = 0.10    # mÂ²Â·K/W (interior pitched/horizontal surface, upward heat flow)
        self.R_SE_ROOF = 0.04    # mÂ²Â·K/W (exterior roof surface, wind-exposed)
        self.R_SI_FLOOR = 0.17   # mÂ²Â·K/W (interior floor surface, downward heat flow)
        self.R_SE_FLOOR = 0.04   # mÂ²Â·K/W (exterior/ground interface surface)

        def _load_materials(self) -> Dict[str, Dict[str, float]]:
        """Load material properties from CSV file."""
        materials = {}
        try:
            with open(self.materials_csv_path, 'r') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    material_id = row['material_id']
                    materials[material_id] = {
                        'thermal_conductivity_W_mK': float(row['thermal_conductivity_W_mK']),
                        'density_kg_m3': float(row['density_kg_m3']),
                        'specific_heat_J_kgK': float(row['specific_heat_J_kgK']),
                        'thermal_emissivity': float(row['thermal_emissivity']),
                        'solar_absorptivity': float(row['solar_absorptivity']),
                        'solar_reflectivity': float(row['solar_reflectivity'])
                    }
        except FileNotFoundError:
            raise FileNotFoundError(f"Materials file not found: {self.materials_csv_path}")
        except Exception as e:
            raise RuntimeError(f"Error loading materials: {e}")

        # Load material ID mapping for compatibility with MAT-* identifiers
        mapping_path = Path(self.materials_csv_path).parent / "material_id_mapping.json"
        if mapping_path.is_file():
            try:
                with open(mapping_path, 'r') as f:
                    mapping = json.load(f)
                for mat_id, numeric_id in mapping.items():
                    if numeric_id in materials and mat_id not in materials:
                        materials[mat_id] = materials[numeric_id]
            except Exception as e:
                # If mapping fails, log but continue (should not break existing functionality)
                print(f"Warning: Could not load material ID mapping: {e}")

        return materials
    def _get_material_properties(self, material_id: str) -> Dict[str, float]:
        """Get material properties by material ID."""
        if material_id not in self.materials:
            raise ValueError(f"Material ID not found: {material_id}")
        return self.materials[material_id]

    def _load_weather_data(self, location: str, start_date: str = "2026-01-01",
                          end_date: str = "2026-12-31") -> List[Dict[str, Any]]:
        """
        Load hourly weather data for a given location.

        Args:
            location: One of "Leh", "Shimla", "Karur", "Karur", "Jaipur"
            start_date: Start date in YYYY-MM-DD format
            end_date: End date in YYYY-MM-DD format

        Returns:
            List of dictionaries containing hourly weather data
        """
        # Validate location
        valid_locations = ["Leh", "Shimla", "Karur", "Jaipur"]
        if location not in valid_locations:
            raise ValueError(f"Location must be one of {valid_locations}")

        # Construct filename
        filename = f"{location.lower()}_weather_2026.csv"
        filepath = self.weather_data_path / filename

        if not filepath.exists():
            raise FileNotFoundError(f"Weather file not found: {filepath}")

        weather_data = []
        try:
            with open(filepath, 'r') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    # Convert numeric fields
                    processed_row = {}
                    for key, value in row.items():
                        if key == 'datetime':
                            processed_row[key] = value
                        else:
                            try:
                                processed_row[key] = float(value) if value != '' else 0.0
                            except ValueError:
                                processed_row[key] = value
                    weather_data.append(processed_row)
        except Exception as e:
            raise RuntimeError(f"Error loading weather data from {filepath}: {e}")

        return weather_data

    def calculate_shelter_geometry(self, shelter_config: Dict[str, Any]) -> Dict[str, float]:
        """
        Calculate shelter geometry parameters.

        Args:
            shelter_config: Dictionary containing shelter parameters

        Returns:
            Dictionary with calculated geometry values
        """
        length = shelter_config['shelter_length_m']
        width = shelter_config['shelter_width_m']
        height = shelter_config['shelter_height_m']

        # Floor area
        floor_area = length * width

        # Wall area (opaque, accounting for openings)
        gross_wall_area = 2 * (length + width) * height
        window_area = shelter_config.get('window_area_m2', 0.0)
        door_area = shelter_config.get('door_area_m2', 0.0)

        if window_area < 0:
            raise ValueError("Window area cannot be negative")
        if door_area < 0:
            raise ValueError("Door area cannot be negative")

        if window_area + door_area >= gross_wall_area:
            raise ValueError(
                f"Total opening area ({window_area + door_area:.2f} mÂ²) must be strictly less than gross wall area ({gross_wall_area:.2f} mÂ²)"
            )

        net_wall_area = max(0.0, gross_wall_area - window_area - door_area)

        # Roof area (accounting for angle)
        roof_angle_rad = math.radians(shelter_config['roof_angle_deg'])
        roof_area = length * width / math.cos(roof_angle_rad) if math.cos(roof_angle_rad) > 0 else length * width

        return {
            'floor_area_m2': floor_area,
            'gross_wall_area_m2': gross_wall_area,
            'net_wall_area_m2': net_wall_area,
            'window_area_m2': window_area,
            'door_area_m2': door_area,
            'roof_area_m2': roof_area,
            'volume_m3': floor_area * height
        }

    def calculate_conductive_heat_flow(self,
                                     shelter_config: Dict[str, Any],
                                     geometry: Dict[str, float],
                                     indoor_temp: float,
                                     outdoor_temp: float) -> Dict[str, float]:
        """
        Calculate conductive heat flow through building envelope.

        Uses: Q = (T_out - T_in) / R where R = L/(k*A)

        Args:
            shelter_config: Shelter configuration dictionary
            geometry: Calculated geometry dictionary
            indoor_temp: Indoor air temperature (Â°C)
            outdoor_temp: Outdoor air temperature (Â°C)

        Returns:
            Dictionary with heat flow values for each component (W)
        """
        # Get material properties
        wall_props = self._get_material_properties(shelter_config['wall_material_id'])
        roof_props = self._get_material_properties(shelter_config['roof_material_id'])
        floor_props = self._get_material_properties(shelter_config['floor_material_id'])

        # Convert thickness from mm to m
        wall_thickness_m = shelter_config['wall_thickness_mm'] / 1000.0
        roof_thickness_m = shelter_config['roof_thickness_mm'] / 1000.0
        floor_thickness_m = shelter_config['floor_thickness_mm'] / 1000.0

        # Calculate material conductive resistances (mÂ²K/W)
        wall_material_r_value = wall_thickness_m / wall_props['thermal_conductivity_W_mK']
        roof_material_r_value = roof_thickness_m / roof_props['thermal_conductivity_W_mK']
        floor_material_r_value = floor_thickness_m / floor_props['thermal_conductivity_W_mK']

        # Calculate air-to-air thermal resistances (mÂ²K/W) including surface film resistances:
        # R_assembly = R_si + (L / k) + R_se
        # Sourced from ISO 6946 / ASHRAE Fundamentals Chapter 26 standard building physics.
        wall_r_value = (self.R_SI_WALL + self.R_SE_WALL) + wall_material_r_value
        roof_r_value = (self.R_SI_ROOF + self.R_SE_ROOF) + roof_material_r_value
        floor_r_value = (self.R_SI_FLOOR + self.R_SE_FLOOR) + floor_material_r_value

        # Calculate effective U-values (W/(mÂ²Â·K))
        # U = 1 / R_assembly
        wall_u_value = 1.0 / wall_r_value if wall_r_value > 0 else float('inf')
        roof_u_value = 1.0 / roof_r_value if roof_r_value > 0 else float('inf')
        floor_u_value = 1.0 / floor_r_value if floor_r_value > 0 else float('inf')

        # Calculate overall thermal resistance for each assembly (K/W)
        # R_total = R_value / A
        wall_r_total = wall_r_value / geometry['net_wall_area_m2'] if geometry['net_wall_area_m2'] > 0 else float('inf')
        roof_r_total = roof_r_value / geometry['roof_area_m2'] if geometry['roof_area_m2'] > 0 else float('inf')
        floor_r_total = floor_r_value / geometry['floor_area_m2'] if geometry['floor_area_m2'] > 0 else float('inf')

        # Calculate heat flow (W) - positive means heat flowing INTO shelter
        # Q = (T_out - T_in) / R_total
        wall_heat_flow = (outdoor_temp - indoor_temp) / wall_r_total if wall_r_total != float('inf') else 0.0
        roof_heat_flow = (outdoor_temp - indoor_temp) / roof_r_total if roof_r_total != float('inf') else 0.0
        floor_heat_flow = (outdoor_temp - indoor_temp) / floor_r_total if floor_r_total != float('inf') else 0.0

        return {
            'wall_heat_flow_W': wall_heat_flow,
            'roof_heat_flow_W': roof_heat_flow,
            'floor_heat_flow_W': floor_heat_flow,
            'wall_material_r_value_m2K_W': wall_material_r_value,
            'roof_material_r_value_m2K_W': roof_material_r_value,
            'floor_material_r_value_m2K_W': floor_material_r_value,
            'wall_r_value_m2K_W': wall_r_value,
            'roof_r_value_m2K_W': roof_r_value,
            'floor_r_value_m2K_W': floor_r_value,
            'wall_u_value_W_m2K': wall_u_value,
            'roof_u_value_W_m2K': roof_u_value,
            'floor_u_value_W_m2K': floor_u_value,
            'wall_r_total_K_W': wall_r_total,
            'roof_r_total_K_W': roof_r_total,
            'floor_r_total_K_W': floor_r_total
        }

    def calculate_thermal_mass(self,
                             shelter_config: Dict[str, Any],
                             geometry: Dict[str, float]) -> Dict[str, float]:
        """
        Calculate effective thermal capacitance of shelter.

        Uses: C = Ï * V * cp for each component

        Args:
            shelter_config: Shelter configuration dictionary
            geometry: Calculated geometry dictionary

        Returns:
            Dictionary with thermal capacitance and component mass properties
        """
        # Get material properties
        wall_props = self._get_material_properties(shelter_config['wall_material_id'])
        roof_props = self._get_material_properties(shelter_config['roof_material_id'])
        floor_props = self._get_material_properties(shelter_config['floor_material_id'])

        # Convert thickness from mm to m
        wall_thickness_m = shelter_config['wall_thickness_mm'] / 1000.0
        roof_thickness_m = shelter_config['roof_thickness_mm'] / 1000.0
        floor_thickness_m = shelter_config['floor_thickness_mm'] / 1000.0

        # Calculate volumes (mÂ³)
        wall_volume = geometry['net_wall_area_m2'] * wall_thickness_m
        roof_volume = geometry['roof_area_m2'] * roof_thickness_m
        floor_volume = geometry['floor_area_m2'] * floor_thickness_m

        # Calculate thermal capacitance for each component (J/K)
        # C = Ï * V * cp
        wall_capacitance = (wall_props['density_kg_m3'] *
                           wall_volume *
                           wall_props['specific_heat_J_kgK'])
        roof_capacitance = (roof_props['density_kg_m3'] *
                           roof_volume *
                           roof_props['specific_heat_J_kgK'])
        floor_capacitance = (floor_props['density_kg_m3'] *
                            floor_volume *
                            floor_props['specific_heat_J_kgK'])

        # Effective thermal capacitance (J/K)
        # Sum of wall, roof, and floor envelope thermal capacitance
        effective_capacitance = wall_capacitance + roof_capacitance + floor_capacitance

        return {
            'wall_volume_m3': wall_volume,
            'roof_volume_m3': roof_volume,
            'floor_volume_m3': floor_volume,
            'wall_density_kg_m3': wall_props['density_kg_m3'],
            'roof_density_kg_m3': roof_props['density_kg_m3'],
            'floor_density_kg_m3': floor_props['density_kg_m3'],
            'wall_specific_heat_J_kgK': wall_props['specific_heat_J_kgK'],
            'roof_specific_heat_J_kgK': roof_props['specific_heat_J_kgK'],
            'floor_specific_heat_J_kgK': floor_props['specific_heat_J_kgK'],
            'wall_heat_capacitance_J_K': wall_capacitance,
            'roof_heat_capacitance_J_K': roof_capacitance,
            'floor_heat_capacitance_J_K': floor_capacitance,
            'effective_thermal_capacitance_J_K': effective_capacitance
        }

    def calculate_solar_gain(self,
                           shelter_config: Dict[str, Any],
                           geometry: Dict[str, float],
                           shortwave_radiation: float) -> float:
        """
        Calculate solar heat gain through envelope.

        Uses: Q = Î± * I * A_effective
        where Î± = solar absorptivity, I = radiation, A = area

        Args:
            shelter_config: Shelter configuration dictionary
            geometry: Calculated geometry dictionary
            shortwave_radiation: Incident shortwave radiation (W/mÂ²)

        Returns:
            Solar heat gain (W)
        """
        # Get material properties for exterior surfaces
        wall_props = self._get_material_properties(shelter_config['wall_material_id'])
        roof_props = self._get_material_properties(shelter_config['roof_material_id'])

        # V1 Simplification: Assume all exterior surfaces have same solar absorptivity
        # and receive same radiation (no directional/shading modeling)
        # In reality, this varies by orientation, time of day, shading, etc.
        wall_absorptivity = wall_props['solar_absorptivity']
        roof_absorptivity = roof_props['solar_absorptivity']

        # Calculate solar gain on each opaque surface
        # Note: We exclude window area as it's treated separately in glazing calculations
        wall_solar_gain = (wall_absorptivity *
                          shortwave_radiation *
                          geometry['net_wall_area_m2'])
        roof_solar_gain = (roof_absorptivity *
                          shortwave_radiation *
                          geometry['roof_area_m2'])

        # For V1, we ignore floor solar gain (assumed shaded or insignificant)
        # Window solar gain would require SHGC calculations (V2)

        total_solar_gain = wall_solar_gain + roof_solar_gain

        return total_solar_gain

    def calculate_ventilation_heat_flow(self,
                                      shelter_config: Dict[str, Any],
                                      geometry: Dict[str, float],
                                      indoor_temp: float,
                                      outdoor_temp: float) -> Dict[str, float]:
        """
        Calculate ventilation/infiltration heat flow.

        Uses: Q = m_dot * cp_air * (T_out - T_in)
        where m_dot = ACH * V_room * Ï_air / 3600

        Args:
            shelter_config: Shelter configuration dictionary
            geometry: Calculated geometry dictionary
            indoor_temp: Indoor air temperature (Â°C)
            outdoor_temp: Outdoor air temperature (Â°C)

        Returns:
            Dictionary with ventilation heat flow and related values
        """
        # Get air change rate from ventilation level
        ventilation_level = shelter_config.get('ventilation_level', 'medium')
        ach_per_hour = self.VENTILATION_ACH_MAP.get(ventilation_level, 1.0)

        # Calculate volumetric flow rate (mÂ³/s)
        # V_dot = ACH * V_room / 3600
        volume_m3 = geometry['volume_m3']
        volumetric_flow_rate = (ach_per_hour * volume_m3) / 3600.0

        # Calculate mass flow rate (kg/s)
        # m_dot = Ï_air * V_dot
        mass_flow_rate = self.RHO_AIR * volumetric_flow_rate

        # Calculate heat flow (W)
        # Q = m_dot * cp_air * (T_out - T_in)
        # Positive means heat entering shelter from ventilation
        ventilation_heat_flow = (mass_flow_rate *
                                self.CP_AIR *
                                (outdoor_temp - indoor_temp))

        return {
            'ventilation_heat_flow_W': ventilation_heat_flow,
            'volumetric_flow_rate_m3_s': volumetric_flow_rate,
            'mass_flow_rate_kg_s': mass_flow_rate,
            'air_changes_per_hour': ach_per_hour
        }

    def calculate_internal_gains(self, shelter_config: Dict[str, Any]) -> float:
        """
        Calculate internal heat gains from occupants.

        Uses: Q = N * q_person
        where N = number of occupants, q_person = sensible heat per person

        Args:
            shelter_config: Shelter configuration dictionary

        Returns:
            Internal heat gain (W)
        """
        occupant_count = shelter_config.get('occupant_count', 1)
        internal_gain = occupant_count * self.SENSIBLE_HEAT_PER_PERSON

        return internal_gain

    def calculate_longwave_radiation(self,
                                   shelter_config: Dict[str, Any],
                                   geometry: Dict[str, float],
                                   indoor_temp: float,
                                   outdoor_temp: float) -> float:
        """
        Calculate long-wave radiation heat exchange.

        Uses simplified approximation: Q = Îµ * Ïƒ * A * (T_out^4 - T_in^4)
        where Îµ = emissivity, Ïƒ = Stefan-Boltzmann constant

        V1 ASSUMPTION: Uses indoor/outdoor air temperatures as surface temperature approximation
        and effective emissivity for building envelope.

        Args:
            shelter_config: Shelter configuration dictionary
            geometry: Calculated geometry dictionary
            indoor_temp: Indoor air temperature (Â°C)
            outdoor_temp: Outdoor air temperature (Â°C)

        Returns:
            Long-wave radiation heat flow (W)
        """
        # Validate temperature safety before Kelvin conversion & exponentiation
        if math.isnan(indoor_temp) or math.isinf(indoor_temp) or indoor_temp < -273.15 or indoor_temp > 1000.0:
            raise ValueError(f"Invalid indoor temperature for longwave radiation: {indoor_temp}")
        if math.isnan(outdoor_temp) or math.isinf(outdoor_temp) or outdoor_temp < -273.15 or outdoor_temp > 1000.0:
            raise ValueError(f"Invalid outdoor temperature for longwave radiation: {outdoor_temp}")

        # Convert temperatures to Kelvin
        T_in_K = indoor_temp + 273.15
        T_out_K = outdoor_temp + 273.15

        # Get material properties for exterior surfaces (use wall as representative)
        wall_props = self._get_material_properties(shelter_config['wall_material_id'])

        # Effective emitting area (simplified - use wall + roof area)
        effective_area = geometry['net_wall_area_m2'] + geometry['roof_area_m2']

        # Calculate net long-wave radiation exchange
        # Q = Îµ * Ïƒ * A * (T_out^4 - T_in^4)
        # Positive means net radiation INTO shelter
        lw_radiation = (self.LONGWAVE_EMISSIVITY *
                       self.STEFAN_BOLTZMANN *
                       effective_area *
                       (T_out_K**4 - T_in_K**4))

        return lw_radiation

    def simulate_hourly(self,
                       shelter_config: Dict[str, Any],
                       weather_data: List[Dict[str, Any]],
                       initial_indoor_temp: Optional[float] = None) -> List[Dict[str, Any]]:
        """
        Run hourly thermal simulation for given weather data.

        Args:
            shelter_config: Shelter configuration dictionary
            weather_data: List of hourly weather data dictionaries
            initial_indoor_temp: Initial indoor temperature (Â°C). If None, uses first outdoor temp.

        Returns:
            List of hourly results dictionaries
        """
        # Validate shelter configuration
        self._validate_shelter_config(shelter_config)

        # Calculate geometry once (assumes constant geometry)
        geometry = self.calculate_shelter_geometry(shelter_config)

        # Calculate thermal mass once (assumes constant material properties)
        thermal_mass = self.calculate_thermal_mass(shelter_config, geometry)
        effective_capacitance = thermal_mass['effective_thermal_capacitance_J_K']

        # Set initial conditions
        if initial_indoor_temp is None and len(weather_data) > 0:
            initial_indoor_temp = weather_data[0].get('temperature_2m', 20.0)
        elif initial_indoor_temp is None:
            initial_indoor_temp = 20.0  # Default fallback

        # Calculate overall equivalent resistance R_eq (K/W) & thermal time constant tau (s & hrs)
        # 1 / R_eq = 1/R_wall_total + 1/R_roof_total + 1/R_floor_total
        conduction_sample = self.calculate_conductive_heat_flow(shelter_config, geometry, initial_indoor_temp, initial_indoor_temp)
        wall_r_tot = conduction_sample['wall_r_total_K_W']
        roof_r_tot = conduction_sample['roof_r_total_K_W']
        floor_r_tot = conduction_sample['floor_r_total_K_W']

        inv_r_eq = (1.0 / wall_r_tot if wall_r_tot > 0 and wall_r_tot != float('inf') else 0.0) + \
                   (1.0 / roof_r_tot if roof_r_tot > 0 and roof_r_tot != float('inf') else 0.0) + \
                   (1.0 / floor_r_tot if floor_r_tot > 0 and floor_r_tot != float('inf') else 0.0)

        r_eq_K_W = 1.0 / inv_r_eq if inv_r_eq > 0 else float('inf')
        time_constant_s = (r_eq_K_W * effective_capacitance) if r_eq_K_W != float('inf') else float('inf')
        time_constant_hours = time_constant_s / 3600.0 if time_constant_s != float('inf') else float('inf')
        numerical_stability_status = "STABLE" if (time_constant_s == float('inf') or 3600.0 < 2.0 * time_constant_s) else "UNSTABLE"

        indoor_temp = initial_indoor_temp
        results = []

        # Process each hour
        for hour_idx, hour_data in enumerate(weather_data):
            # Validate numerical bounds before step
            if math.isnan(indoor_temp) or math.isinf(indoor_temp) or indoor_temp < -273.15 or indoor_temp > 1000.0:
                raise ValueError(f"Numerical instability detected at hour {hour_idx}: indoor_temp = {indoor_temp}")

            # Extract weather variables (using Open-Meteo variable names)
            outdoor_temp = hour_data.get('temperature_2m', 0.0)  # Â°C
            shortwave_radiation = hour_data.get('shortwave_radiation', 0.0)  # W/mÂ²
            wind_speed = hour_data.get('windspeed_10m', 0.0)  # km/h

            # Calculate heat flows for this hour
            conduction = self.calculate_conductive_heat_flow(
                shelter_config, geometry, indoor_temp, outdoor_temp)

            solar_gain = self.calculate_solar_gain(
                shelter_config, geometry, shortwave_radiation)

            ventilation = self.calculate_ventilation_heat_flow(
                shelter_config, geometry, indoor_temp, outdoor_temp)

            internal_gain = self.calculate_internal_gains(shelter_config)

            longwave_radiation = self.calculate_longwave_radiation(
                shelter_config, geometry, indoor_temp, outdoor_temp)

            # Calculate net heat flow (W)
            # Positive Q_net means heat GAIN by shelter
            # Sum of all heat flow components entering indoor air
            q_net = (conduction['wall_heat_flow_W'] +
                    conduction['roof_heat_flow_W'] +
                    conduction['floor_heat_flow_W'] +
                    solar_gain +
                    internal_gain +
                    longwave_radiation +
                    ventilation['ventilation_heat_flow_W'])

            # Energy balance verification audit (error should be zero within numerical float tolerance)
            sum_components = (conduction['wall_heat_flow_W'] +
                              conduction['roof_heat_flow_W'] +
                              conduction['floor_heat_flow_W'] +
                              solar_gain +
                              internal_gain +
                              longwave_radiation +
                              ventilation['ventilation_heat_flow_W'])
            energy_balance_error_W = abs(q_net - sum_components)

            # Update indoor temperature using thermal capacitance
            # Î”T = (Q_net * Î”t) / C
            # where Î”t = 3600 seconds (1 hour)
            if effective_capacitance > 0:
                delta_t = (q_net * 3600.0) / effective_capacitance
                indoor_temp += delta_t
            else:
                delta_t = 0.0

            # Store results for this hour
            hour_result = {
                'timestamp': hour_data.get('datetime', f'hour_{hour_idx}'),
                'location': shelter_config.get('location', 'Unknown'),
                'outdoor_temperature_C': outdoor_temp,
                'indoor_temperature_C': indoor_temp,
                'temperature_difference_C': indoor_temp - outdoor_temp,
                'relative_humidity_outdoor_percent': hour_data.get('relativehumidity_2m', 0.0),
                'solar_radiation_W_m2': shortwave_radiation,
                'wind_speed_kmh': wind_speed,
                'wall_heat_flow_W': conduction['wall_heat_flow_W'],
                'roof_heat_flow_W': conduction['roof_heat_flow_W'],
                'floor_heat_flow_W': conduction['floor_heat_flow_W'],
                'solar_gain_W': solar_gain,
                'ventilation_heat_flow_W': ventilation['ventilation_heat_flow_W'],
                'internal_gain_W': internal_gain,
                'longwave_radiation_W': longwave_radiation,
                'net_heat_flow_W': q_net,
                'thermal_risk_category': self._assess_thermal_risk(indoor_temp),
                # Diagnostic fields
                'wall_material_r_value_m2K_W': conduction['wall_material_r_value_m2K_W'],
                'roof_material_r_value_m2K_W': conduction['roof_material_r_value_m2K_W'],
                'floor_material_r_value_m2K_W': conduction['floor_material_r_value_m2K_W'],
                'wall_r_value_m2K_W': conduction['wall_r_value_m2K_W'],
                'roof_r_value_m2K_W': conduction['roof_r_value_m2K_W'],
                'floor_r_value_m2K_W': conduction['floor_r_value_m2K_W'],
                'wall_u_value_W_m2K': conduction['wall_u_value_W_m2K'],
                'roof_u_value_W_m2K': conduction['roof_u_value_W_m2K'],
                'floor_u_value_W_m2K': conduction['floor_u_value_W_m2K'],
                'effective_capacitance_J_K': effective_capacitance,
                'thermal_time_constant_s': time_constant_s,
                'thermal_time_constant_hours': time_constant_hours,
                'energy_balance_error_W': energy_balance_error_W,
                'numerical_stability_status': numerical_stability_status,
                'delta_t_C': delta_t,
                'ach': ventilation['air_changes_per_hour']
            }

            results.append(hour_result)

        return results

    def _validate_shelter_config(self, shelter_config: Dict[str, Any]) -> None:
        """Validate shelter configuration parameters."""
        # Check required fields
        required_fields = [
            'shelter_id', 'shelter_name', 'location',
            'shelter_length_m', 'shelter_width_m', 'shelter_height_m',
            'wall_material_id', 'wall_thickness_mm',
            'roof_material_id', 'roof_thickness_mm',
            'roof_type', 'roof_angle_deg',
            'floor_material_id', 'floor_thickness_mm',
            'shelter_orientation_deg',
            'occupant_count', 'ventilation_level',
            'elevation_m', 'shading_level', 'ground_condition',
            'design_type'
        ]

        for field in required_fields:
            if field not in shelter_config:
                raise ValueError(f"Missing required field: {field}")

        # Validate numeric ranges
        if shelter_config['shelter_length_m'] <= 0:
            raise ValueError("Shelter length must be positive")
        if shelter_config['shelter_width_m'] <= 0:
            raise ValueError("Shelter width must be positive")
        if shelter_config['shelter_height_m'] <= 0:
            raise ValueError("Shelter height must be positive")
        if shelter_config['wall_thickness_mm'] <= 0:
            raise ValueError("Wall thickness must be positive")
        if shelter_config['roof_thickness_mm'] <= 0:
            raise ValueError("Roof thickness must be positive")
        if shelter_config['floor_thickness_mm'] <= 0:
            raise ValueError("Floor thickness must be positive")
        if not (0 <= shelter_config['roof_angle_deg'] <= 90):
            raise ValueError("Roof angle must be between 0 and 90 degrees")
        if shelter_config['occupant_count'] < 1:
            raise ValueError("Occupant count must be at least 1")

        # Validate location
        valid_locations = ["Leh", "Shimla", "Karur", "Jaipur"]
        if shelter_config['location'] not in valid_locations:
            raise ValueError(f"Location must be one of {valid_locations}")

        # Validate material IDs exist
        for material_field in ['wall_material_id', 'roof_material_id', 'floor_material_id']:
            material_id = shelter_config[material_field]
            if material_id not in self.materials:
                raise ValueError(f"Material ID not found in materials database: {material_id}")

    def _assess_thermal_risk(self, indoor_temp: float) -> str:
        """
        Assess thermal risk category based on indoor temperature.

        V1 ASSUMPTION: Simple temperature-based categories.
        These are engineering assumptions, not ASHRAE comfort standards.

        Args:
            indoor_temp: Indoor air temperature (Â°C)

        Returns:
            Thermal risk category string
        """
        if indoor_temp < -10:
            return "EXTREME_COLD"
        elif indoor_temp < 5:
            return "COLD"
        elif indoor_temp <= 25:
            return "ACCEPTABLE"
        elif indoor_temp <= 35:
            return "HOT"
        else:
            return "EXTREME_HOT"


def run_v1_simulation(shelter_config: Dict[str, Any],
                     location: str,
                     hours: int = 24) -> List[Dict[str, Any]]:
    """
    Convenience function to run a V1 thermal simulation.

    Args:
        shelter_config: Shelter configuration dictionary
        location: Weather location ("Leh", "Shimla", "Karur", "Jaipur")
        hours: Number of hours to simulate (default: 24)

    Returns:
        List of hourly simulation results
    """
    engine = ThermalEngine()

    # Load weather data
    weather_data = engine._load_weather_data(location)

    # Limit to requested hours
    if hours < len(weather_data):
        weather_data = weather_data[:hours]

    # Run simulation
    results = engine.simulate_hourly(shelter_config, weather_data)

    return results


def compare_materials(shelter_config: Dict[str, Any],
                      location: str = "Leh",
                      hours: int = 24,
                      material_ids: Optional[List[str]] = None) -> List[Dict[str, Any]]:
    """
    Controlled engineering comparison of shelter performance across different wall materials.

    Args:
        shelter_config: Base shelter configuration dictionary
        location: Weather dataset location ("Leh", "Shimla", "Karur", "Jaipur")
        hours: Number of simulation hours (default: 24)
        material_ids: List of material IDs to compare (default: Adobe, Stone, Timber, EPS, Metal)

    Returns:
        List of dictionaries with performance metrics for each material
    """
    if material_ids is None:
        material_ids = ["MAT-ADOBE", "MAT-STONE", "MAT-TIMBER", "MAT-EPS", "MAT-METAL"]

    engine = ThermalEngine()
    weather_data = engine._load_weather_data(location)[:hours]

    comparison_results = []
    for mat_id in material_ids:
        config = shelter_config.copy()
        config["wall_material_id"] = mat_id
        config["shelter_id"] = f"SHEL-MAT-COMP-{mat_id}"

        results = engine.simulate_hourly(config, weather_data)

        indoor_temps = [r['indoor_temperature_C'] for r in results]
        wall_heats = [abs(r['wall_heat_flow_W']) for r in results]

        first_hour = results[0]
        comparison_results.append({
            'material_id': mat_id,
            'wall_r_value_m2K_W': first_hour['wall_r_value_m2K_W'],
            'wall_u_value_W_m2K': first_hour['wall_u_value_W_m2K'],
            'avg_indoor_temp_C': sum(indoor_temps) / len(indoor_temps),
            'min_indoor_temp_C': min(indoor_temps),
            'max_indoor_temp_C': max(indoor_temps),
            'avg_wall_heat_flow_W': sum(wall_heats) / len(wall_heats),
            'temp_range_C': max(indoor_temps) - min(indoor_temps)
        })

    return comparison_results


if __name__ == "__main__":
    # Example usage and basic testing
    print("V1 Thermal Physics Engine - Example Usage")
    print("=" * 50)

    # Example shelter configuration (Ladakh passive shelter)
    example_shelter = {
        "shelter_id": "SHEL-LEH-001",
        "shelter_name": "Ladakh Passive Shelter V1",
        "location": "Leh",
        "shelter_length_m": 5.0,
        "shelter_width_m": 4.0,
        "shelter_height_m": 2.8,
        "wall_material_id": "MAT-ADOBE",
        "wall_thickness_mm": 300,
        "roof_material_id": "MAT-THATCH",
        "roof_thickness_mm": 200,
        "roof_type": "pitched",
        "roof_angle_deg": 30,
        "floor_material_id": "MAT-STONE",
        "floor_thickness_mm": 150,
        "shelter_orientation_deg": 0,
        "window_area_m2": 2.0,
        "door_area_m2": 2.0,
        "window_orientation": "S",
        "glazing_type": "double",
        "occupant_count": 2,
        "occupancy_schedule": "full-time",
        "ventilation_level": "medium",
        "elevation_m": 3500,
        "shading_level": "medium",
        "ground_condition": "soil",
        "design_type": "passive",
        "notes": "Example Ladakh shelter for demonstration"
    }

    # Run a 6-hour simulation for demonstration
    try:
        results = run_v1_simulation(example_shelter, "Leh", hours=6)

        print(f"Simulated {len(results)} hours for {example_shelter['shelter_name']}")
        print(f"Location: {example_shelter['location']}")
        print()

        # Print first and last hour results
        if results:
            print("First hour:")
            first = results[0]
            for key, value in first.items():
                if isinstance(value, float):
                    print(f"  {key}: {value:.2f}")
                else:
                    print(f"  {key}: {value}")

            print()
            print("Last hour:")
            last = results[-1]
            for key, value in last.items():
                if isinstance(value, float):
                    print(f"  {key}: {value:.2f}")
                else:
                    print(f"  {key}: {value}")

    except Exception as e:
        print(f"Error running simulation: {e}")
        import traceback
        traceback.print_exc()
