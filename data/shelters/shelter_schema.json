{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V1 Shelter Configuration Schema",
  "description": "Schema for defining shelter configurations to be used by the V1 thermal simulation engine for ThermoShelter SIH26051 project. Focuses on high-altitude cold regions (Ladakh/Leh) with comparison to Shimla, Karur, and Jaipur.",
  "type": "object",
  "required": [
    "shelter_id",
    "shelter_name",
    "location",
    "shelter_length_m",
    "shelter_width_m",
    "shelter_height_m",
    "wall_material_id",
    "wall_thickness_mm",
    "roof_material_id",
    "roof_thickness_mm",
    "roof_type",
    "roof_angle_deg",
    "floor_material_id",
    "floor_thickness_mm",
    "shelter_orientation_deg",
    "occupant_count",
    "ventilation_level",
    "elevation_m",
    "shading_level",
    "ground_condition",
    "design_type"
  ],
  "properties": {
    "shelter_id": {
      "type": "string",
      "description": "Unique identifier for the shelter configuration",
      "pattern": "^SHEL-[A-Z0-9_-]+$",
      "examples": ["SHEL-LEH-001", "SHEL-SHIMLA-BASIC"]
    },
    "shelter_name": {
      "type": "string",
      "description": "Descriptive name for the shelter configuration",
      "minLength": 1,
      "maxLength": 100,
      "examples": ["Ladakh Passive Shelter V1", "Shimla Comparison Model"]
    },
    "location": {
      "type": "string",
      "description": "Location key referencing weather datasets (Leh, Shimla, Karur, Jaipur)",
      "enum": ["Leh", "Shimla", "Karur", "Jaipur"],
      "default": "Leh"
    },
    "shelter_length_m": {
      "type": "number",
      "description": "Length of the shelter in meters",
      "minimum": 1.0,
      "maximum": 100.0,
      "examples": [5.0, 10.0, 15.0]
    },
    "shelter_width_m": {
      "type": "number",
      "description": "Width of the shelter in meters",
      "minimum": 1.0,
      "maximum": 50.0,
      "examples": [4.0, 8.0, 12.0]
    },
    "shelter_height_m": {
      "type": "number",
      "description": "Height of the shelter in meters",
      "minimum": 1.5,
      "maximum": 10.0,
      "examples": [2.5, 3.0, 3.5]
    },
    "floor_area_m2": {
      "type": "number",
      "description": "Derived field: floor area in square meters (calculated as shelter_length_m × shelter_width_m)",
      "minimum": 1.0,
      "maximum": 5000.0,
      "readOnly": true
    },
    "wall_area_m2": {
      "type": "number",
      "description": "Derived field: total wall area in square meters (calculated as 2 × (shelter_length_m + shelter_width_m) × shelter_height_m)",
      "minimum": 1.0,
      "maximum": 10000.0,
      "readOnly": true
    },
    "roof_area_m2": {
      "type": "number",
      "description": "Derived field: roof area in square meters (calculated as shelter_length_m × shelter_width_m / cos(roof_angle_deg × π/180))",
      "minimum": 1.0,
      "maximum": 10000.0,
      "readOnly": true
    },
    "wall_material_id": {
      "type": "string",
      "description": "Reference to material ID from data/materials/material_properties.csv",
      "pattern": "^MAT-[A-Z0-9_-]+$",
      "examples": ["MAT-ADOBE", "MAT-STONE", "MAT-TIMBER"]
    },
    "wall_thickness_mm": {
      "type": "number",
      "description": "Wall thickness in millimeters",
      "minimum": 50,
      "maximum": 1000,
      "examples": [250, 300, 350]
    },
    "roof_material_id": {
      "type": "string",
      "description": "Reference to material ID from data/materials/material_properties.csv",
      "pattern": "^MAT-[A-Z0-9_-]+$",
      "examples": ["MAT-THATCH", "MAT-METAL", "MAT-WOOD"]
    },
    "roof_thickness_mm": {
      "type": "number",
      "description": "Roof thickness in millimeters",
      "minimum": 10,
      "maximum": 500,
      "examples": [150, 200, 300]
    },
    "roof_type": {
      "type": "string",
      "description": "Type of roof construction",
      "enum": ["flat", "pitched", "gabled", "hipped", "skillion", "butterfly"],
      "default": "pitched"
    },
    "roof_angle_deg": {
      "type": "number",
      "description": "Roof angle in degrees from horizontal (0 = flat, 90 = vertical)",
      "minimum": 0,
      "maximum": 90,
      "examples": [30, 45, 60]
    },
    "floor_material_id": {
      "type": "string",
      "description": "Reference to material ID from data/materials/material_properties.csv",
      "pattern": "^MAT-[A-Z0-9_-]+$",
      "examples": ["MAT-STONE", "MAT-CONCRETE", "MAT-TIMBER"]
    },
    "floor_thickness_mm": {
      "type": "number",
      "description": "Floor thickness in millimeters",
      "minimum": 50,
      "maximum": 500,
      "examples": [100, 150, 200]
    },
    "window_area_m2": {
      "type": "number",
      "description": "Total window area in square meters",
      "minimum": 0,
      "maximum": 100,
      "examples": [2.0, 5.0, 10.0]
    },
    "door_area_m2": {
      "type": "number",
      "description": "Total door area in square meters",
      "minimum": 0,
      "maximum": 20,
      "examples": [2.0, 3.5, 5.0]
    },
    "window_orientation": {
      "type": "string",
      "description": "Primary orientation of windows (cardinal directions)",
      "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"],
      "default": "S"
    },
    "glazing_type": {
      "type": "string",
      "description": "Type of window glazing",
      "enum": ["single", "double", "triple", "low-e"],
      "default": "double"
    },
    "shelter_orientation_deg": {
      "type": "number",
      "description": "Shelter orientation in degrees from North (clockwise)",
      "minimum": 0,
      "maximum": 360,
      "examples": [0, 90, 180, 270],
      "default": 0
    },
    "occupant_count": {
      "type": "integer",
      "description": "Number of occupants in the shelter",
      "minimum": 1,
      "maximum": 20,
      "examples": [2, 4, 6]
    },
    "occupancy_schedule": {
      "type": "string",
      "description": "Occupancy pattern (simplified for V1)",
      "enum": ["full-time", "day-only", "night-only", "weekends"],
      "default": "full-time"
    },
    "ventilation_level": {
      "type": "string",
      "description": "Ventilation level (qualitative for V1)",
      "enum": ["sealed", "low", "medium", "high"],
      "default": "medium"
    },
    "elevation_m": {
      "type": "number",
      "description": "Site elevation in meters above sea level",
      "minimum": 0,
      "maximum": 5000,
      "examples": [3500, 2200, 1500, 300]
    },
    "shading_level": {
      "type": "string",
      "description": "Site shading level from surrounding terrain/objects",
      "enum": ["none", "low", "medium", "high", "full"],
      "default": "medium"
    },
    "ground_condition": {
      "type": "string",
      "description": "Ground condition at shelter site",
      "enum": ["rocky", "soil", "sand", "gravel", "snow", "ice"],
      "default": "soil"
    },
    "design_type": {
      "type": "string",
      "description": "Type of shelter design",
      "enum": ["passive", "active", "hybrid", "traditional", "modern"],
      "default": "passive"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the shelter design",
      "maxLength": 1000
    }
  },
  "additionalProperties": false
}