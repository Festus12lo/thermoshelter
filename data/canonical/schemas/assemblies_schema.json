{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Assemblies Schema",
  "type": "object",
  "required": [
    "assembly_id",
    "assembly_name",
    "component_type",
    "total_r_value_m2K_W",
    "effective_u_value_W_m2K",
    "source_id",
    "status"
  ],
  "properties": {
    "assembly_id": {
      "type": "string",
      "pattern": "^ASM-[A-Z0-9_-]+$"
    },
    "assembly_name": {
      "type": "string"
    },
    "component_type": {
      "type": "string",
      "enum": [
        "WALL",
        "ROOF",
        "FLOOR"
      ]
    },
    "application_region": {
      "type": "string"
    },
    "total_thickness_mm": {
      "type": "number"
    },
    "total_r_value_m2K_W": {
      "type": "number"
    },
    "effective_u_value_W_m2K": {
      "type": "number"
    },
    "thermal_mass_strategy": {
      "type": "string"
    },
    "insulation_strategy": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "RESEARCH_REQUIRED",
        "DEPRECATED"
      ]
    }
  }
}